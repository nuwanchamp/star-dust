{
  "name": "@encenlab/star-dust",
  "version": "0.2.0",
  "description": "Interactive WebGL dust-particle typography: text, images and layouts formed from drifting motes.",
  "type": "module",
  "license": "MIT",
  "author": "encenlab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuwanchamp/star-dust.git"
  },
  "sideEffects": false,
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/types/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./core": {
      "types": "./dist-lib/types/lib/core.d.ts",
      "import": "./dist-lib/core.js"
    },
    "./react": {
      "types": "./dist-lib/types/lib/react.d.ts",
      "import": "./dist-lib/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/fix-dts-extensions.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-lib",
    "lint": "tsc --noEmit && tsc --noEmit -p tests",
    "prepublishOnly": "npm run lint && npm run build:lib",
    "test": "bun test tests",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.3.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "playwright-core": "1.56.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
